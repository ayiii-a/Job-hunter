# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，绝不要提交。
#   cp .env.example .env

# --- LLM（Phase 2 起用）---
ANTHROPIC_API_KEY=

# --- 通知（Discord）---
# 推送用频道 webhook：频道设置 → 整合 → Webhook → 复制 URL。
# webhook 只能往这一个频道发消息，读不了、也管不了别的。URL 本身就是密钥，别外传
DISCORD_WEBHOOK_URL=
# 你的 Discord 用户 id：设置 → 高级 → 打开开发者模式，右键自己的头像 → 复制用户 ID。
# agent openclaw config 用它当聊天入口的白名单
DISCORD_USER_ID=

# --- 邮件（Phase 5 用）---
# 用 IMAP + App Password，不用 Gmail API：gmail.readonly 是 restricted scope，
# 个人项目只能停在 Testing 模式，refresh token 每 7 天过期。详见路线图 Phase 5。
# Gmail 的 App Password 在 Google 账号设置里生成（需先开两步验证）。
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- 运行参数 ---
JHA_DB_PATH=data/jha.db
JHA_DAILY_APPLY_LIMIT=8
JHA_GHOST_AFTER_DAYS=30
